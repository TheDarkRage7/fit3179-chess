  "encoding": {
    "x": {
      "field": "rating_group",
      "type": "ordinal",
      "sort": [
        "Below 1200",
        "1200–1599",
        "1600–1999",
        "2000+"
      ],
      "title": "Average of White and Black Lichess ratings",
      "axis": {
        "labelAngle": 0
      },
      "scale": {
        "padding": 0.15
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "title": "Popularity rank among the six families shown",
      "scale": {
        "domain": [
          1,
          6
        ],
        "reverse": true,
        "zero": false,
        "nice": false
      },
      "axis": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "format": "d"
      }
    },
    "color": {
      "field": "opening",
      "type": "nominal",
      "scale": {
        "domain": [
          "Sicilian Defense",
          "French Defense",
          "Queen's Pawn Game",
          "Italian Game",
          "King's Pawn Game",
          "Ruy Lopez"
        ],
        "range": [
          "#426B50",
          "#477DA8",
          "#976C87",
          "#A57636",
          "#467F80",
          "#786D9C"
        ]
      },
      "legend": {
        "title": null,
        "orient": "bottom",
        "columns": 2,
        "labelLimit": 230
      }
    },
    "opacity": {
      "condition": {
        "param": "openingPick",
        "value": 1
      },
      "value": 0.15
    },
    "tooltip": [
      {
        "field": "opening",
        "title": "Opening family",
        "type": "nominal"
      },
      {
        "field": "rating_group",
        "title": "Average rating",
        "type": "ordinal"
      },
      {
        "field": "rank",
        "title": "Rank among six shown",
        "type": "quantitative"
      },
      {
        "field": "games",
        "title": "Games using this family",
        "type": "quantitative",
        "format": ","
      },
      {
        "field": "group_games",
        "title": "All games in rating group",
        "type": "quantitative",
        "format": ","
      },
      {
        "field": "share",
        "title": "Share of all group games",
        "type": "quantitative",
        "format": ".1%"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      }
    },
    {
      "params": [
        {
          "name": "openingPick",
          "select": {
            "type": "point",
            "fields": [
              "opening"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 85
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rating_group === '2000+'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 12,
        "limit": 170
      },
      "encoding": {
        "text": {
          "field": "opening"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "title": {
      "anchor": "start",
      "fontSize": 19,
      "subtitleFontSize": 11
    },
    "legend": {
      "labelFontSize": 12
    }
